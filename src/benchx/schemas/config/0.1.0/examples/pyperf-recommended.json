{
  "schema_version": "benchx/config/0.1.0",
  "adapter": {
    "name": "pyperf",
    "suite": "benchmarks/bench_example.py",
    "quantities": ["wall-time"],
    "precision": {
      "repetitions": { "mode": "fixed", "levels": [{ "unit": "process", "n": 20 }, { "unit": "value", "n": 3 }] },
      "calibration": { "mode": "adaptive", "minimum_sample_seconds": 0.1 },
      "warmup": { "mode": "count", "n_warmup": 1 }
    }
  },
  "environment_variables": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "timeouts": { "case_s": 120, "order_s": 1800 }
}
