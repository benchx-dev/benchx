{
  "identity_schema": "benchx/default/v1",
  "description": "The default identity policy. Series follow the subject revision; every coordinate matches except environment.system, of which only the runtime matches.",
  "axis": [{ "path": "/revision/key", "order": "revision-graph" }],
  "default": "match",
  "paths": {
    "/source/uri": { "normalize": { "rule": "canonical-uri" } },
    "/coordinates/environment/system": "ignore",
    "/coordinates/environment/system/runtime": "match"
  },
  "estimators": [{ "name": "median", "method_version": "benchx/median/v1", "input_level": "observations" }]
}
