{
  "identity_schema": "benchx/default/v1",
  "description": "The default identity policy. Series follow the subject revision; every coordinate matches except environment facts, of which only the runtime matches.",
  "default": "match",
  "estimators": [{ "name": "median", "method_version": "benchx/median/v1", "input_level": "observations" }],
  "rules": [
    {
      "scope": {},
      "paths": {
        "/revision/key": { "axis": { "order": "revision-graph" } },
        "/source/uri": { "normalize": { "rule": "canonical-uri" } },
        "/coordinates/environment/facts": "ignore",
        "/coordinates/environment/facts/runtime": "match"
      }
    }
  ]
}
