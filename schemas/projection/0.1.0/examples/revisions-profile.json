{
  "identity_schema": "benchx/profile/revisions/v1",
  "description": "The revisions profile (UC-03): two subject trees from one run, everything else matching as under the default.",
  "axis": [{ "path": "/provenance/subject_tree", "order": "unordered" }],
  "default": "match",
  "paths": {
    "/coordinates/environment/system": "ignore",
    "/coordinates/environment/system/runtime": "match"
  },
  "invariants": ["one-run", "two-sides", "one-tree-per-side", "equal-attempts", "alternating-slots", "clean-tree"]
}
