{
  "schema_version": "benchx/config/0.1.0",
  "project": "archery-local",
  "provider": { "command": ["./provider.sh"] },
  "adapter": {
    "name": "google-benchmark",
    "suite": "demo-bench",
    "quantities": ["wall-time"],
    "precision": { "repetitions": 5 }
